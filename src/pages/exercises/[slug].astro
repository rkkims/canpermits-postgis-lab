---
import Site from '../../layouts/Site.astro';
import AnnotatedCode from '../../components/AnnotatedCode.astro';
import EvidenceCard from '../../components/EvidenceCard.astro';
import { listExercises, loadAnnotations } from '../../lib/content.mjs';
export function getStaticPaths() { return listExercises().map((exercise) => ({ params: { slug: exercise.folder }, props: { exercise } })); }
const { exercise } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const solutionNotes = loadAnnotations(exercise, 'annotations.yml', exercise.attempt);
const fixtureNotes = loadAnnotations(exercise, 'fixture-annotations.yml', exercise.fixtures);
const solved = !exercise.attempt.includes('Write your own solution here');
const lede = exercise.context.match(/^.*?\.(?:\s|$)/)?.[0]?.trim() ?? exercise.context;
const testCases = exercise.edgeCases.split(';').map((item) => item.trim()).filter(Boolean);
const previous = listExercises().find((item) => Number(item.number) === Number(exercise.number) - 1);
const next = listExercises().find((item) => Number(item.number) === Number(exercise.number) + 1);
---
<Site title={`Exercise ${exercise.number}: ${exercise.title}`} description={exercise.context}>
  <div class="page-shell">
    <a class="back-link" href={`${base}/#curriculum`}>← All exercises</a>
    <div class="exercise-header"><div><span class="eyebrow">EXERCISE {exercise.number} / {exercise.level.toUpperCase()}</span><h1>{exercise.title}</h1><p class="lede">{lede}</p></div><div class="status"><span class="pill">{solved ? 'My SQL added' : 'Ready to solve'}</span>{exercise.portfolio && <span class="pill portfolio">Portfolio candidate</span>}</div></div>
    <div class="content-grid"><div class="main-column">
      <section class="content-section" id="problem"><span class="section-kicker">THE PROBLEM</span><h2>Why this operation exists</h2><p>{exercise.context}</p><div class="problem-callout"><span class="small-label">YOUR TASK</span><p>{exercise.problem}</p></div><h3>Learning objective</h3><p>{exercise.objective}</p><h3>Expected behavior</h3><p>{exercise.expected}</p></section>
      <section class="content-section" id="dataset"><span class="section-kicker">DATA & CONTEXT</span><h2>Start with the source</h2><div class="source-card"><div><span class="small-label">PUBLIC DATA SOURCE</span><h3><a href={exercise.evidence?.source?.url} target="_blank" rel="noopener noreferrer">{exercise.evidence?.source?.label} ↗</a></h3><p>{exercise.evidence?.source?.relation}</p></div><div class="source-note">The exercise fixture is synthetic. Use the linked public source to understand the real format and provenance.</div></div><div class="before-after"><EvidenceCard exercise={exercise} side="before" /><EvidenceCard exercise={exercise} side="after" /></div><p class="context-note">Attach your own <code>after.csv</code> or evidence image in this exercise folder, then reference it from <code>evidence.yml</code>. The site will show it after the next build.</p></section>
      <section class="content-section" id="code"><span class="section-kicker">THE CODE</span><h2>Your spatial SQL</h2><p>Write and test <code>attempt.sql</code> locally. Add reasoning to <code>annotations.yml</code> after making the decision yourself. Hover over a marked line for a preview; click or focus it for a persistent explanation.</p><AnnotatedCode code={exercise.attempt} filename="attempt.sql" notes={solutionNotes} id="solution-code" emptyMessage={solved ? '' : 'Your solution has not been written yet. The exercise is ready for your independent attempt.'} /></section>
      <section class="content-section" id="input-sql"><span class="section-kicker">RUNNABLE INPUT</span><h2>See the schema and fixture</h2><p>The schema defines the small scratch tables. The fixture adds synthetic input rows. Exercise 01 has sample annotations on its fixture to demonstrate the interface without revealing solution SQL.</p><AnnotatedCode code={exercise.schema} filename="schema.sql" id="schema-code" /><div class="fixture-gap"></div><AnnotatedCode code={exercise.fixtures} filename="fixtures.sql" notes={fixtureNotes} id="fixture-code" /></section>
      <section class="content-section" id="validation"><span class="section-kicker">VALIDATION</span><h2>Test cases</h2><p>These are inputs that could reveal a wrong assumption in your query. After writing your SQL, make a small row for each case, predict the result, run it, and record what happened in <code>tests.md</code>. They are questions to investigate, not prescribed answers.</p><ul class="case-list">{testCases.map((testCase) => <li>{testCase}</li>)}</ul><h3>Concepts to research</h3><p>{exercise.concepts}</p></section>
      <nav class="exercise-nav" aria-label="Exercise navigation">{previous ? <a href={`${base}/exercises/${previous.folder}/`}>← {previous.number} · {previous.title}</a> : <span></span>}{next ? <a href={`${base}/exercises/${next.folder}/`}>{next.number} · {next.title} →</a> : <span></span>}</nav>
    </div><aside class="side-column"><div class="side-sticky"><span class="small-label">ON THIS PAGE</span><nav aria-label="On this page"><a href="#problem">01 · The problem</a><a href="#dataset">02 · Data & context</a><a href="#code">03 · Your SQL</a><a href="#input-sql">04 · Input fixture</a><a href="#validation">05 · Test cases</a></nav><div class="side-help"><strong>Work independently</strong><p>Predict each test outcome before running your SQL. Record what surprised you.</p></div></div></aside></div>
  </div>
</Site>
<style>
  .page-shell{max-width:1350px;margin:auto;padding:2rem 4vw 5rem}.back-link{text-decoration:none;color:var(--teal);font-weight:600;font-size:.85rem}.exercise-header{display:flex;justify-content:space-between;gap:2rem;align-items:end;padding:2.5rem 0 3rem;border-bottom:1px solid var(--line)}.exercise-header h1{font-size:clamp(2.5rem,4vw,4.5rem);max-width:780px}.lede{font-size:1.1rem;color:var(--muted);max-width:700px}.status{display:flex;gap:.4rem;flex-wrap:wrap;justify-content:flex-end}.pill.portfolio{color:#ad623e;border-color:#eec2af}.content-grid{display:grid;grid-template-columns:minmax(0,1fr) 205px;gap:5vw}.main-column{min-width:0}.content-section{padding:3.5rem 0;border-bottom:1px solid var(--line);scroll-margin-top:1rem}.content-section h2{margin:.4rem 0 1.2rem}.content-section h3{margin:1.8rem 0 .4rem}.content-section p{max-width:790px;color:#456168}.content-section code{font-family:'DM Mono',monospace;font-size:.85em;background:#e9eee9;padding:.1rem .2rem;border-radius:3px}.section-kicker,.small-label{font-size:.7rem;letter-spacing:.16em;font-weight:700;color:var(--teal)}.problem-callout{border-left:4px solid var(--orange);background:#fff;padding:1.2rem 1.4rem;margin:2rem 0}.problem-callout p{font-size:1.13rem;color:var(--ink);margin:.45rem 0 0}.source-card{display:flex;justify-content:space-between;gap:2rem;background:#e7f3ed;border:1px solid #c8e4d5;border-radius:14px;padding:1.3rem;margin:1.7rem 0}.source-card h3{margin:.4rem 0}.source-card h3 a{color:var(--ink);text-decoration-color:var(--teal)}.source-card p{margin:0;font-size:.82rem}.source-note{border-left:1px solid #b5d6c6;padding-left:1.2rem;max-width:260px;font-size:.76rem;color:#54736d}.before-after{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}.context-note{font-size:.82rem}.fixture-gap{height:1rem}.source-list{padding-left:1.2rem}.source-list li{margin:.5rem 0;overflow-wrap:anywhere}.side-sticky{position:sticky;top:1rem;padding-top:2rem}.side-sticky nav{display:flex;flex-direction:column;gap:.9rem;margin:1.1rem 0 2rem}.side-sticky nav a{text-decoration:none;font-size:.8rem;color:var(--muted)}.side-sticky nav a:hover{color:var(--teal)}.side-help{border-top:1px solid var(--line);padding-top:1rem;font-size:.8rem}.side-help p{color:var(--muted)}.exercise-nav{display:flex;justify-content:space-between;gap:1rem;padding-top:2rem;font-size:.84rem}.exercise-nav a{color:var(--teal);max-width:45%}@media(max-width:950px){.content-grid{grid-template-columns:1fr}.side-column{display:none}}@media(max-width:650px){.page-shell{padding:1rem 5vw 3rem}.exercise-header{display:block;padding:2rem 0}.status{justify-content:flex-start}.before-after{grid-template-columns:1fr}.source-card{display:block}.source-note{border-left:0;border-top:1px solid #b5d6c6;padding:1rem 0 0;margin-top:1rem}.content-section{padding:2.5rem 0}}
  .case-list{list-style:none;padding:0;margin:1.4rem 0 2rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.case-list li{background:#fff;border:1px solid var(--line);border-left:3px solid #8acdc0;border-radius:5px;padding:.75rem .9rem;font-size:.87rem}@media(max-width:650px){.case-list{grid-template-columns:1fr}}
</style>
