---
import Site from '../layouts/Site.astro';
import { listExercises } from '../lib/content.mjs';
const exercises = listExercises();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const levels = ['Foundations','Real CanPermits operations','Correctness and edge cases','Performance and engineering decisions'];
const summary = (text) => text.match(/^.*?\.(?:\s|$)/)?.[0]?.trim() ?? text;
---
<Site title="Curriculum" description="A self-directed PostGIS curriculum drawn from real CanPermits engineering problems.">
  <section class="hero"><div class="hero-inner"><div><span class="eyebrow">FIELD NOTES / POSTGIS / CANPERMITS</span><h1>Learn spatial SQL<br /><em>from real systems.</em></h1><p>Eighteen focused exercises drawn from municipal GIS ingestion, permit geocoding, boundary reasoning, zoning, proximity, and query performance.</p><div class="hero-actions"><a class="button" href={`${base}/exercises/${exercises[0].folder}/`}>Start exercise 01 <span aria-hidden="true">↗</span></a><a class="button secondary" href={`${base}/about/`}>How this lab works</a></div></div><div class="hero-art" aria-hidden="true"><div class="map-grid"></div><div class="map-shape shape-one"></div><div class="map-shape shape-two"></div><span class="map-point p1"></span><span class="map-point p2"></span><span class="map-point p3"></span><div class="map-caption">POINT → POLYGON → DECISION</div></div></div></section>
  <section class="intro-band"><div><strong>Source grounded</strong><span>Each problem maps to a CanPermits workflow.</span></div><div><strong>Solution first</strong><span>Your SQL stays blank until you write it.</span></div><div><strong>Explain the why</strong><span>Line notes capture your decisions.</span></div></section>
  <section class="curriculum" id="curriculum"><div class="section-heading"><div><span class="eyebrow">THE CURRICULUM</span><h2>Build understanding,<br />one decision at a time.</h2></div><p>Each exercise comes with a small synthetic dataset, a runnable schema, edge cases, and source-file pointers to inspect after your attempt.</p></div>
    {levels.map((level, levelIndex) => <div class="level-group"><div class="level-title"><span class="level-number">0{levelIndex + 1}</span><h3>{level}</h3></div><div class="exercise-grid">{exercises.filter((item) => item.level === level).map((item) => <a class="exercise-card" href={`${base}/exercises/${item.folder}/`}><div class="card-top"><span class="mono">EXERCISE {item.number}</span>{item.portfolio && <span class="portfolio-tag">PORTFOLIO</span>}</div><h3>{item.title}</h3><p>{summary(item.context)}</p><span class="card-arrow" aria-hidden="true">↗</span></a>)}</div></div>)}
  </section>
  <section class="closing"><span class="eyebrow">YOUR WORK, YOUR REASONING</span><h2>Write the query. Test the edge. Explain the decision.</h2><a class="button" href={`${base}/exercises/${exercises[0].folder}/`}>Begin with coordinates →</a></section>
</Site>
<style>
  .hero{background:#d9f3e9;border-bottom:1px solid #b6d8ce}.hero-inner{max-width:1350px;margin:auto;padding:5.4rem 4vw;display:grid;grid-template-columns:1.2fr .8fr;gap:4rem;align-items:center}.hero h1 em{font-style:normal;color:#147d72}.hero p{font-size:1.13rem;max-width:600px;color:#3f6465}.hero-actions{display:flex;gap:.8rem;margin-top:2rem;flex-wrap:wrap}.hero-actions .button{gap:1rem}.hero-art{height:350px;position:relative;background:#c3e9dd;border:1px solid #85c7b6;border-radius:26px;overflow:hidden;box-shadow:18px 18px 0 #b4e3d4}.map-grid{position:absolute;inset:0;background-image:linear-gradient(#8bc5b355 1px,transparent 1px),linear-gradient(90deg,#8bc5b355 1px,transparent 1px);background-size:32px 32px}.map-shape{position:absolute;transform:rotate(-9deg);border:2px solid #2f9a8f}.shape-one{width:250px;height:210px;top:50px;left:70px;clip-path:polygon(5% 8%,95% 3%,85% 60%,50% 65%,35% 100%,5% 80%);background:#a4ded1}.shape-two{width:200px;height:170px;top:140px;left:190px;clip-path:polygon(0 15%,100% 0,85% 100%,10% 85%);background:#7dc8bb66}.map-point{position:absolute;width:17px;height:17px;border:4px solid white;background:#ed7149;border-radius:50%;box-shadow:0 2px 12px #227a6a}.p1{top:112px;left:175px}.p2{top:220px;left:292px}.p3{top:275px;left:120px}.map-caption{position:absolute;left:22px;bottom:18px;background:#fff;padding:.4rem .65rem;font:11px 'DM Mono',monospace;letter-spacing:.06em}.intro-band{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:1.3rem 4vw;background:#fff;border-bottom:1px solid var(--line)}.intro-band div{display:flex;flex-direction:column;border-right:1px solid var(--line);padding:.4rem 1rem}.intro-band div:last-child{border:0}.intro-band strong{font-size:.87rem}.intro-band span{color:var(--muted);font-size:.78rem}.curriculum{max-width:1350px;margin:auto;padding:5rem 4vw}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:3rem;margin-bottom:3rem}.section-heading h2{margin:.5rem 0}.section-heading p{max-width:390px;color:var(--muted)}.level-group{margin:3rem 0}.level-title{display:flex;align-items:center;gap:.75rem;border-bottom:1px solid var(--line);margin-bottom:1rem}.level-number{font:600 .78rem 'DM Mono',monospace;color:var(--teal)}.level-title h3{font-size:1rem}.exercise-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.exercise-card{position:relative;background:#fff;border:1px solid var(--line);border-radius:14px;padding:1.25rem 1.3rem 2.4rem;min-height:190px;text-decoration:none;transition:transform .2s,border-color .2s}.exercise-card:hover{transform:translateY(-4px);border-color:#72b5a4}.card-top{display:flex;justify-content:space-between;gap:.5rem;color:var(--teal);font-size:.68rem;font-weight:600;letter-spacing:.05em}.portfolio-tag{color:#af5d3e}.exercise-card h3{margin:1rem 0 .4rem;font-size:1.1rem}.exercise-card p{color:var(--muted);font-size:.8rem;margin:0}.card-arrow{position:absolute;right:1.3rem;bottom:.8rem;font-size:1.25rem;color:var(--teal)}.closing{padding:5rem 4vw;text-align:center;background:#17343d;color:white}.closing h2{max-width:700px;margin:1rem auto 2rem}.closing .button{background:#b6eee3;color:#17343d;border-color:#b6eee3}@media(max-width:900px){.hero-inner{grid-template-columns:1fr}.hero-art{max-width:600px}.exercise-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.hero-inner{padding:3rem 5vw}.hero-art{height:250px}.intro-band{grid-template-columns:1fr}.intro-band div{border-right:0;border-bottom:1px solid var(--line)}.section-heading{display:block}.exercise-grid{grid-template-columns:1fr}.curriculum{padding:3rem 5vw}}
</style>
